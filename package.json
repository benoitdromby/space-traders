    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
