# Copy to .env.local (git-ignored) to override defaults. Never put secrets here.
#
# IMPORTANT: every VITE_* variable is embedded in the public JS bundle and is
# visible to anyone who loads the site. Do NOT store the API bearer token in a
# VITE_* variable. The token is entered by the user at runtime on the splash
# page (see src/api/authToken.ts).

# Base URL of the SpaceTraders API
VITE_API_BASE_URL=https://api.spacetraders.io/v2

# Public path the app is served from. Use "/" locally; on GitHub Pages this is
# "/<repository-name>/" (set automatically by the deploy workflow).
VITE_BASE_PATH=/
